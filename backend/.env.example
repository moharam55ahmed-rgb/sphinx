PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="mysql://root:password@localhost:3306/sphinx_db"

# JWT
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# CORS: * = allow any origin (citysphinx.com, vercel, localhost, …)
CORS_ORIGIN=*

# Legacy / docs only (not used for CORS when CORS_ORIGIN is set)
FRONTEND_URL=http://localhost:3000

# Optional: only needed if API returns absolute URLs elsewhere
# BACKEND_URL=http://localhost:5000
