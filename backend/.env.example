PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="mysql://root:password@localhost:3306/sphinx_db"

# JWT
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# CORS is allow-all (*) in code — no env needed

FRONTEND_URL=http://localhost:3000

# Optional: only needed if API returns absolute URLs elsewhere
# BACKEND_URL=http://localhost:5000

# Form notifications → info@citysphinx.com
NOTIFY_EMAIL=info@citysphinx.com
MAIL_FROM=City Sphinx <noreply@citysphinx.com>
MAIL_REPLY_TO=info@citysphinx.com

# SMTP (required for email delivery — e.g. Gmail, SendGrid, host SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
